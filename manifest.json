{
  "name": "sxiphone - iOS 風格手機介面",
  "short_name": "sxiphone",
  "description": "iOS 風格的手機介面模擬器，提供聊天、設定等多種應用功能",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "fullscreen", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0b0c12",
  "theme_color": "#0b0c12",
  "categories": ["entertainment", "utilities", "social"],
  "lang": "zh-TW",
  "dir": "ltr",
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "apps/screenshots/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/icon-120x120.png",
      "sizes": "120x120",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/current.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "apps/screenshots/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "apps/screenshots/current.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "apps/screenshots/current.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "sxiphone 主畫面"
    }
  ],
  "shortcuts": [
    {
      "name": "聊天",
      "short_name": "聊天",
      "description": "開啟聊天應用",
      "url": "/?app=chat",
      "icons": [{ "src": "apps/screenshots/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "設定",
      "short_name": "設定",
      "description": "開啟設定",
      "url": "/?app=settings",
      "icons": [{ "src": "apps/screenshots/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/?app=chat",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+sxi",
      "url": "/?app=%s"
    }
  ],
  "related_applications": [],
  "id": "/"
}
